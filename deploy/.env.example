# Copy to deploy/.env on the VM (never commit the real file).

# Public hostname of this VM. No domain needed: use your static IP with dashes + sslip.io,
# e.g. IP 34.93.10.20  ->  DOMAIN=34-93-10-20.sslip.io   (HTTPS works automatically)
# Or use a real name you control, e.g. DOMAIN=api.drretina.app (DNS A record -> the VM IP).
DOMAIN=

# The Vercel site URL (used for the API's origin check).
APP_URL=https://dr-retina-web.vercel.app

# Supabase (same values as website/.../backend/.env)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=retinal-images

# Use the Supabase session-pooler URL (IPv4). Direct db.<ref>.supabase.co hosts are IPv6-only.
API_DATABASE_URL=postgresql://retina_api.<project-ref>:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
WORKER_DATABASE_URL=postgresql://retina_worker.<project-ref>:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Shared secret between worker and AI service. Generate with:  openssl rand -hex 32
AI_SERVICE_KEY=
AI_MODEL_VERSION=dr-retina-2026.09-p0-p2d

WORKER_POLL_SECONDS=3
WORKER_LEASE_SECONDS=300
